# Copy to .env and fill in. .env stays out of git; the pre-commit hook blocks its values from commits.

# iOS app, read by scripts/generate.sh when it makes Sift.xcodeproj.
# Reverse-DNS prefix you own: the app becomes <prefix>.sift.
SIFT_BUNDLE_ID_PREFIX=com.example
# Your Apple team ID (Xcode > Settings > Accounts). Empty: select the team in Xcode after each generate.
SIFT_DEVELOPMENT_TEAM=

# Mac companion. Where you lived, in date order: city,lat,lon[,until] per home, separated by ";".
# A photo dated before `until` uses that home. Events more than 30 km from home count as trips.
SIFT_HOMES="Lyon,45.764,4.836,2021-06-01;Paris,48.857,2.352"
# Local state (database, caches, evals.toml). Default ~/.sift-mac.
# SIFT_HOME=
